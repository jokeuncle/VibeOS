# Copy to deploy/.env and fill in secrets (never commit .env)
# Volcengine Ark / OpenAI-compatible
ARK_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional alias — compose also reads this if set
# LLM_API_KEY=

# GitLab (agents: pm-agent, architecture-agent; tools use GITLAB_URL or GITLAB_BASE_URL)
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
