FROM python:3.14-slim
WORKDIR /app
COPY agents/shared/ /deps/shared/
RUN pip install --no-cache-dir /deps/shared/
COPY agents/architecture-agent/pyproject.toml .
RUN pip install --no-cache-dir .
COPY agents/architecture-agent/ .
EXPOSE 8041
CMD ["uvicorn", "arch_agent.main:app", "--host", "0.0.0.0", "--port", "8041"]
