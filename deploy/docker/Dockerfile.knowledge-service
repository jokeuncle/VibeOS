FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY platform/knowledge-service/pyproject.toml .
RUN pip install --no-cache-dir .
COPY platform/knowledge-service/ .
EXPOSE 8070
CMD ["uvicorn", "knowledge_service.main:app", "--host", "0.0.0.0", "--port", "8070"]
