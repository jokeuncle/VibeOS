# Copy to .env and fill in secrets (never commit .env)

# === LLM Provider (pick ONE, configure its API key) ===
# Option A: OpenAI
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Option B: DeepSeek
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Option C: Anthropic (via litellm)
# LLM_API_KEY=sk-ant-xxxx
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-20250514

# Option D: Volcengine Ark (China)
# LLM_API_KEY=your-ark-api-key
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-seed-2-0-pro-260215

# Legacy alias — if set, takes precedence over LLM_API_KEY for Volcengine
# ARK_API_KEY=

# === GitLab (optional, for code management features) ===
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# === Infrastructure ===
DATABASE_URL=postgres://vibeos:vibeos_dev@localhost:5432/vibeos?sslmode=disable

# === Embedding (memory-service + rag-pipeline, FastEmbed ONNX) ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# === Optional: Tencent COS (artifact upload) ===
# VIBEOS_COS_UPLOAD=1
# COS_BUCKET=your-bucket-name
# COS_REGION=ap-guangzhou
# COS_CDN_BASE=https://your-cdn.example.com
# COS_SECRET_ID=your-secret-id
# COS_SECRET_KEY=your-secret-key

# === Optional: Feishu/Lark ===
# FEISHU_APP_ID=your-app-id
# FEISHU_APP_SECRET=your-app-secret
