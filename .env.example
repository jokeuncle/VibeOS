# --- Infrastructure ---
DATABASE_URL=postgres://vibeos:vibeos_dev@localhost:5432/vibeos?sslmode=disable

# --- Embedding (memory-service + rag-pipeline, FastEmbed ONNX — avoids Py3.14+ transformers import bugs) ---
